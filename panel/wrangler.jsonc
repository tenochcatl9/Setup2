{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setup-mc-panel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    {
      "binding": "ESTADO",
      "id": "PEGA_AQUI_EL_ID_DE_ESTADO"
    }
  ],
  "observability": {
    "enabled": true
  }
}
