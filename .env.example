# Copia este archivo a .env y rellena lo que uses.
# .env está en .gitignore: nunca se sube.
DISCORD_WEBHOOK=

# Página pública (Cloudflare Pages): guía y descarga del script.
# El script baja de aquí la interfaz (html/js/css) y las versiones nuevas
# de sí mismo. Por defecto apunta a https://tenohost.pages.dev; pon "no"
# para desactivarla por completo.
PAGINA_URL=
# Proyecto de Cloudflare Pages donde desplegar la página con --publicar
# (requiere npx wrangler autenticado). Vacío = no se publica la página.
PAGES_PROYECTO=

# Panel (Cloudflare Workers): auto-actualización, plugins y estado en vivo.
# Despliega el Worker de panel/ (ver panel/README.md) y pega aquí su URL
# y la misma clave que pusiste con: npx wrangler secret put PANEL_API_KEY
PANEL_URL=
PANEL_API_KEY=
